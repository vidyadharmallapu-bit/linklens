# LinkLens — Supabase Configuration
# Copy this file to .env and fill in your credentials.
# Get these from: Supabase Dashboard > Project Settings > API
#
# Accepted key formats:
#   Legacy anon key:   eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#   Publishable key:   sb_publishable_...
#
# NEVER use your service_role key or database password here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here
